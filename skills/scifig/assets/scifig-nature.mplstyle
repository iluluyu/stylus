figure.constrained_layout.wspace: 0.04
savefig.dpi: 600
savefig.bbox: standard
savefig.transparent: False
svg.fonttype: none
svg.hashsalt: scifig
pdf.fonttype: 42
ps.fonttype: 42
image.cmap: viridis
image.interpolation: nearest
