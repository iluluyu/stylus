# scifig style for Nature. Generated by scifig.style.export_mplstyle

font.family: sans-serif
font.sans-serif: Arial, Helvetica, Helvetica Neue, Liberation Sans, TeX Gyre Heros, Nimbus Sans, Arimo, DejaVu Sans
font.size: 7
axes.labelsize: 7
axes.titlesize: 7
axes.titleweight: normal
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6
legend.title_fontsize: 6
figure.titlesize: 7
text.color: 1A1A1A
axes.labelcolor: 1A1A1A
xtick.color: 1A1A1A
ytick.color: 1A1A1A
axes.edgecolor: 1A1A1A
mathtext.fontset: custom
mathtext.rm: Arial
mathtext.it: Arial:italic
mathtext.bf: Arial:bold
mathtext.sf: Arial
mathtext.cal: Arial:italic
mathtext.default: it
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.facecolor: none
axes.grid: False
axes.axisbelow: True
axes.labelpad: 2.5
axes.titlepad: 3.0
axes.xmargin: 0.02
axes.ymargin: 0.04
axes.prop_cycle: cycler('color', ['1A5FA0', 'CF5B2A', '118C6E', 'C26FA3', 'E1A02E', '5BADDF'])
grid.color: E3E3E3
grid.linewidth: 0.4
grid.linestyle: -
xtick.direction: out
ytick.direction: out
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.minor.size: 1.5
ytick.minor.size: 1.5
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.4
ytick.minor.width: 0.4
xtick.major.pad: 2.0
ytick.major.pad: 2.0
lines.linewidth: 1.0
lines.markersize: 3.0
lines.markeredgewidth: 0.6
lines.solid_capstyle: round
patch.linewidth: 0.6
hatch.linewidth: 0.5
errorbar.capsize: 0
scatter.edgecolors: none
legend.frameon: False
legend.borderpad: 0.2
legend.borderaxespad: 0.3
legend.handlelength: 1.4
legend.handletextpad: 0.4
legend.labelspacing: 0.3
legend.columnspacing: 1.0
figure.dpi: 150
figure.facecolor: white
figure.constrained_layout.use: False
figure.constrained_layout.h_pad: 0.027777777777777776
figure.constrained_layout.w_pad: 0.027777777777777776
